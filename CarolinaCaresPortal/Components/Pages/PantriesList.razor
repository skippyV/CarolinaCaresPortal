@page "/pantriesList"

@rendermode InteractiveServer
@inject IMongoDbAccessService _iMongoDbAccessService

@inject DialogService DialogService

<h3>Pantries</h3>

<RadzenDataList AllowVirtualization=@allowVirtualization Style="@(allowVirtualization ? "height:400px;overflow:auto;" : "")"
                WrapItems="@(!allowVirtualization)" AllowPaging="@(!allowVirtualization)" ShowEmptyMessage
                Data="@AllPantries" TItem="FoodPantry" PageSize="5" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true">
    <EmptyTemplate>No records found</EmptyTemplate>
    <Template Context="pantry">
        <RadzenCard Variant="Variant.Outlined" class="rz-p-0" Style="width: 100%; overflow: hidden;">
            <RadzenRow class="rz-text-align-center" Gap="0">

                <RadzenColumn Size="2" class="rz-p-4 rz-color-on-secondary-lighter rz-border rz-border-color-series-3" Style="--rz-border-width: 5px">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H5">@(pantry.Name)</RadzenText>
                </RadzenColumn>

                <RadzenColumn Size="2" class="rz-p-4 rz-border rz-border-color-success" Style="--rz-border-width: 5px">
                    <RadzenButton Text="Select" Click=@(args => SelectPantry(pantry.Id)) />
                </RadzenColumn>

                <RadzenColumn Size="2" class="rz-p-4 rz-border rz-border-color-success" Style="--rz-border-width: 5px">
                    <RadzenButton Text="Delete" Click=@(args => ConfirmPantryDeleteAction(pantry.Id)) />
                </RadzenColumn>

            </RadzenRow>
        </RadzenCard>
    </Template>
</RadzenDataList>

@if (SelectedPantry is not null)
{
    <h6>Selected Pantry</h6>

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start"
                 JustifyContent="JustifyContent.Start" Gap="0.5rem"
                 Style="width: 50%; max-width: 700px;"
                 class="rz-p-sm-6 rz-border rz-border-color-success-dark">

        <RadzenLabel Component="TextBoxBindPantryName">
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="0.25rem"
                         class="">
                Name
                <RadzenTextBox @bind-Value=@SelectedPantry.Name Style="width: 50%; max-width: 300px;" Name="TextBoxBindPantryName" />
            </RadzenStack>
        </RadzenLabel>

    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start"
                 JustifyContent="JustifyContent.Start" Gap="0.5rem" class="rz-p-sm-6 rz-border rz-border-primary">

        <RadzenLabel Text="Street Info" Component="BindTextBoxBindAddressStreetInfo" Style="width: 50%">
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="0.25rem">
                Street Info
                <RadzenTextBox @bind-Value=@SelectedPantry.Address.StreetInfo
                               Name="BindTextBoxBindAddressStreetInfo" />
            </RadzenStack>
        </RadzenLabel>

        <RadzenLabel Component="BindTextBoxBindAddressCity">
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="0.25rem">
                City
                <RadzenTextBox @bind-Value=@SelectedPantry.Address.City
                               Name="BindTextBoxBindAddressCity" />
            </RadzenStack>
        </RadzenLabel>

    </RadzenStack>
}
else
{
    <p>No Pantry selected</p>
}

<p>@statusMessage</p>

@code {
    bool allowVirtualization;
    string statusMessage = string.Empty;

    FoodPantry? SelectedPantry;

    List<FoodPantry>? AllPantries { get; set; }

    [PersistentState]
    public bool? dejaVuFlag { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // if (dejaVuFlag is null) // first time here so skip pulling data from Db
        // {
        //     dejaVuFlag = true;
        // }
        // else
        // {
        RetrieveListOfPantries();
        // }

    }

    private void RetrieveListOfPantries()
    {
        AllPantries = _iMongoDbAccessService.GetFoodPantries();
    }

    private void SelectPantry(string pantryId)
    {
        // Before selecting we have to have the proper list generated
        // for the current users

        if (!string.IsNullOrEmpty(pantryId))
        {
            SelectedPantry = _iMongoDbAccessService.GetFoodPantryById(pantryId);
            if (SelectedPantry is not null)
            {
                statusMessage = $"Selected Pantry: {SelectedPantry.Name}";
            }
            else
            {
                statusMessage = $"Warning! Selected Pantry is NULL!!";
            }
        }
    }

    private async Task ConfirmPantryDeleteAction(string pantryId)
    {
        var confirmationResult = await this.DialogService.Confirm("Are you sure?",
                                                                  "Dialog Title",
                                                                  new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });
        if (confirmationResult == true)
        {
            DeletePantry(pantryId);
        }
    }

    private void DeletePantry( string pantryId)
    {
        try
        {
            // var deleteResult = _iOpovDbAccessService.DeleteOpovEventAsync(eventId);
            // deleteResult.Wait();  // executing .Wait() just 'hanged', so changed to 'await'
            var deleteResult =  _iMongoDbAccessService.DeletePantryRecord(pantryId);
            if (deleteResult.Success)
            {
                RetrieveListOfPantries(); // reload list of pantries
                ClearInputFields(); 
                //   _NavigationManager.Refresh();
            }
            else
            {
                Log.Error("DeleteOpovEvent failed in AdminPanel");
            }

        }
        catch (Exception ex)
        {
            Log.Error(ex.Message);
        }

    }

    private void ClearInputFields()
    {
        SelectedPantry = null;
        statusMessage = "";
        StateHasChanged();
    }
}
