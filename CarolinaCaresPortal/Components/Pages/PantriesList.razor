@page "/pantriesList"

@rendermode InteractiveServer
@inject IMongoDbAccessService _iMongoDbAccessService

<h3>Pantries</h3>

<RadzenDataList AllowVirtualization=@allowVirtualization Style="@(allowVirtualization ? "height:400px;overflow:auto;" : "")"
                WrapItems="@(!allowVirtualization)" AllowPaging="@(!allowVirtualization)" ShowEmptyMessage
                Data="@AllPantries" TItem="FoodPantry" PageSize="5" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true">
    <EmptyTemplate>No records found</EmptyTemplate>
    <Template Context="pantry">
        <RadzenCard Variant="Variant.Outlined" class="rz-p-0" Style="width: 100%; overflow: hidden;">
            <RadzenRow class="rz-text-align-center" Gap="0">

                <RadzenColumn Size="2" class="rz-p-4 rz-color-on-secondary-lighter rz-border rz-border-color-series-3" Style="--rz-border-width: 5px">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H5">@(pantry.Name)</RadzenText>
                </RadzenColumn>

                <RadzenColumn Size="2" class="rz-p-4 rz-border rz-border-color-success" Style="--rz-border-width: 5px">
                    <RadzenButton Text="Select" Click=@(args => SelectPantry(pantry.Id)) />
                </RadzenColumn>

                <RadzenColumn Size="2" class="rz-p-4 rz-border rz-border-color-success" Style="--rz-border-width: 5px">
                    <RadzenButton Text="Delete" Click=@(args => DeletePantryRecord(pantry.Id)) />
                </RadzenColumn>

            </RadzenRow>
        </RadzenCard>
    </Template>
</RadzenDataList>

<p>@statusMessage</p>

@code {
    bool allowVirtualization;
    string statusMessage = string.Empty;

    FoodPantry? SelectedPantry;

    List<FoodPantry>? AllPantries { get; set; }

    [PersistentState]
    public bool? dejaVuFlag { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // if (dejaVuFlag is null) // first time here so skip pulling data from Db
        // {
        //     dejaVuFlag = true;
        // }
        // else
        // {
        RetrieveListOfPantries();
        // }

    }

    private void RetrieveListOfPantries()
    {
        AllPantries = _iMongoDbAccessService.GetFoodPantries();
    }

    private void SelectPantry(string pantryId)
    {
        // Before selecting we have to have the proper list generated
        // for the current users
        //  SelectedOpovEvent =
        if (!string.IsNullOrEmpty(pantryId))
        {
            SelectedPantry = _iMongoDbAccessService.GetFoodPantryById(pantryId);
            if (SelectedPantry is not null)
            {
                statusMessage = $"Selected Event: {SelectedPantry.Name}";
            }
            else
            {
                statusMessage = $"Warning! Selected Event is NULL!!";
            }
        }
    }

    private void DeletePantryRecord( string pantryId)
    {
        try
        {
            // var deleteResult = _iOpovDbAccessService.DeleteOpovEventAsync(eventId);
            // deleteResult.Wait();  // executing .Wait() just 'hanged', so changed to 'await'
            var deleteResult =  _iMongoDbAccessService.DeletePantryRecord(pantryId);
            if (deleteResult.Success)
            {
                RetrieveListOfPantries();
                StateHasChanged();
                //   _NavigationManager.Refresh();
            }
            else
            {
                Log.Error("DeleteOpovEvent failed in AdminPanel");
            }

        }
        catch (Exception ex)
        {
            Log.Error(ex.Message);
        }

    }
}
